<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Henzify</title>
  <style>
    :root{
      --bg:#f6f1e8;
      --card:#ffffff;
      --text:#2f2a24;
      --muted:#6d665e;
      --beige:#e8dccd;
      --green:#cfe1d3;
      --green2:#a8c9b0;
      --accent:#7c9c84;
      --shadow:0 12px 30px rgba(0,0,0,.08);
      --radius:22px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:Arial, Helvetica, sans-serif;
      background:linear-gradient(180deg,#fffdf8 0%, var(--bg) 100%);
      color:var(--text);
    }
    a{text-decoration:none;color:inherit}
    .wrap{width:min(1150px, calc(100% - 30px)); margin:0 auto}
    .nav{
      position:sticky; top:0; z-index:20;
      background:rgba(246,241,232,.92);
      backdrop-filter:blur(10px);
      border-bottom:1px solid rgba(0,0,0,.05);
    }
    .nav-inner{
      display:flex; align-items:center; justify-content:space-between;
      padding:14px 0; gap:12px; flex-wrap:wrap;
    }
    .brand{
      font-size:24px; font-weight:800; letter-spacing:1px;
      color:#4f6a57;
    }
    .menu{display:flex; gap:16px; flex-wrap:wrap; color:var(--muted); font-size:14px}
    .hero{
      display:grid; grid-template-columns:1.1fr .9fr; gap:22px;
      padding:48px 0 18px;
    }
    .hero-box, .panel, .card{
      background:var(--card);
      border:1px solid rgba(0,0,0,.06);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
    }
    .hero-box{padding:30px; background:linear-gradient(135deg, rgba(207,225,211,.7), rgba(232,220,205,.7))}
    .kicker{
      display:inline-block;
      padding:8px 12px;
      background:rgba(255,255,255,.55);
      border-radius:999px;
      font-size:12px;
      color:#55705d;
      font-weight:700;
      letter-spacing:1px;
      text-transform:uppercase;
    }
    h1{
      margin:14px 0 12px;
      font-size:clamp(36px, 6vw, 62px);
      line-height:1.03;
    }
    .lead{color:var(--muted); line-height:1.7; font-size:16px; max-width:62ch}
    .btns{display:flex; gap:12px; flex-wrap:wrap; margin-top:22px}
    .btn{
      display:inline-flex; align-items:center; justify-content:center;
      padding:12px 18px; border-radius:999px;
      font-weight:700; border:1px solid transparent;
    }
    .btn.primary{background:#6f8f77; color:#fff}
    .btn.secondary{background:#fff; border-color:#d9d0c5}
    .stats{
      display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:22px;
    }
    .stat{
      background:rgba(255,255,255,.55);
      border:1px solid rgba(0,0,0,.05);
      border-radius:16px; padding:14px;
    }
    .stat b{display:block; margin-bottom:4px}
    .stat span{color:var(--muted); font-size:13px}
    .hero-side{
      padding:18px;
      display:flex; flex-direction:column; gap:12px;
      justify-content:space-between;
    }
    .hero-side img{
      width:100%; height:320px; object-fit:cover; border-radius:18px;
    }
    .chips{display:flex; gap:10px; flex-wrap:wrap}
    .chip{
      padding:8px 12px; border-radius:999px;
      background:var(--green); color:#4f6a57; font-size:13px; font-weight:700;
      border:1px solid rgba(0,0,0,.04);
    }
    section{padding:26px 0}
    .section-head{
      display:flex; justify-content:space-between; gap:16px; align-items:end;
      margin-bottom:16px;
    }
    .section-head h2{margin:0; font-size:28px}
    .section-head p{margin:0; color:var(--muted); max-width:58ch}
    .grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
    .card{overflow:hidden}
    .card img{width:100%; height:220px; object-fit:cover}
    .card-body{padding:16px; display:grid; gap:10px}
    .meta{display:flex; justify-content:space-between; gap:10px; font-size:13px; color:var(--muted)}
    .price{font-size:18px; font-weight:800; color:#5d7d66}
    .card-body .btn{width:100%}
    .track{
      display:grid; grid-template-columns:repeat(4,1fr); gap:12px;
    }
    .step{
      padding:16px; border-radius:18px; background:#fff; box-shadow:var(--shadow);
      border:1px solid rgba(0,0,0,.05);
    }
    .step b{display:block; margin-bottom:6px}
    .contact{
      display:grid; grid-template-columns:1fr 1fr; gap:18px;
    }
    .panel{padding:18px}
    .list{display:grid; gap:10px; color:var(--muted)}
    .form{
      display:grid; gap:10px;
    }
    .form input, .form textarea{
      width:100%;
      padding:12px 14px;
      border-radius:14px;
      border:1px solid #d9d0c5;
      font:inherit;
      background:#fff;
      outline:none;
    }
    .form textarea{min-height:110px; resize:vertical}
    .footer{
      text-align:center; color:var(--muted);
      padding:28px 0 40px; font-size:14px;
    }
    @media (max-width: 900px){
      .hero, .grid, .track, .contact, .stats{grid-template-columns:1fr}
      .section-head{flex-direction:column; align-items:start}
    }
  </style>
</head>
<body>
  <div class="nav">
    <div class="wrap nav-inner">
      <div class="brand">HENZIFY</div>
      <div class="menu">
        <a href="#home">Home</a>
        <a href="#shop">Shop</a>
        <a href="#track">Track Order</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </div>

  <main class="wrap" id="home">
    <div class="hero">
      <div class="hero-box">
        <span class="kicker">Beige & Pastel Green Shop</span>
        <h1>Soft style, easy shopping, and direct ordering with Henzify.</h1>
        <p class="lead">
          Henzify is a reseller-friendly online shop for trendy everyday finds.
          Customers can browse products, click to order, and send their details
          so you can process requests smoothly.
        </p>
        <div class="btns">
          <a class="btn primary" href="#shop">Shop Now</a>
          <a class="btn secondary" href="#contact">Order Form</a>
        </div>
        <div class="stats">
          <div class="stat"><b>Direct</b><span>Click contact links anytime</span></div>
          <div class="stat"><b>Clickable</b><span>Open product links instantly</span></div>
          <div class="stat"><b>Trackable</b><span>Show order progress clearly</span></div>
        </div>
      </div>

      <div class="hero-side panel">
        <img src="https://images.unsplash.com/photo-1523474253046-8cd2748b5fd2?auto=format&fit=crop&w=1200&q=80" alt="Aesthetic shop" />
        <div class="chips">
          <span class="chip">Phone Accessories</span>
          <span class="chip">Fashion</span>
          <span class="chip">Beauty</span>
          <span class="chip">Accessories</span>
        </div>
      </div>
    </div>

    <section id="shop">
      <div class="section-head">
        <div>
          <h2>Featured Products</h2>
          <p>Replace the sample links below with your real product links from TikTok or any shop page.</p>
        </div>
      </div>

      <div class="grid">
        <article class="card">
          <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=1200&q=80" alt="Redmi A5 case" />
          <div class="card-body">
            <div class="meta"><span>Phone Accessories</span><span>Best Seller</span></div>
            <h3>Redmi A5 Aesthetic Casing</h3>
            <div>Simple, cute, and protective case for daily use.</div>
            <div class="price">₱199</div>
            <a class="btn primary" href="https://your-product-link-1.com" target="_blank" rel="noopener">Buy Now</a>
          </div>
        </article>

        <article class="card">
          <img src="https://images.unsplash.com/photo-1572635196237-14b3f281503f?auto=format&fit=crop&w=1200&q=80" alt="Wireless earbuds" />
          <div class="card-body">
            <div class="meta"><span>Audio</span><span>Popular</span></div>
            <h3>Wireless Earbuds</h3>
            <div>Good sound, easy pairing, and comfortable fit.</div>
            <div class="price">₱499</div>
            <a class="btn primary" href="https://your-product-link-2.com" target="_blank" rel="noopener">Buy Now</a>
          </div>
        </article>

        <article class="card">
          <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1200&q=80" alt="Fashion and beauty" />
          <div class="card-body">
            <div class="meta"><span>Fashion & Beauty</span><span>Trending</span></div>
            <h3>Baggy Pants / Beauty Items</h3>
            <div>Soft style essentials for casual and aesthetic looks.</div>
            <div class="price">₱350</div>
            <a class="btn primary" href="https://your-product-link-3.com" target="_blank" rel="noopener">Buy Now</a>
          </div>
        </article>
      </div>
    </section>

    <section id="track">
      <div class="section-head">
        <div>
          <h2>Order Progress</h2>
          <p>Customers can follow the order flow from confirmation to delivery.</p>
        </div>
      </div>

      <div class="track">
        <div class="step"><b>Confirmed</b><span>Order received and checked.</span></div>
        <div class="step"><b>Processing</b><span>Preparing the item.</span></div>
        <div class="step"><b>In Transit</b><span>On the way to the customer.</span></div>
        <div class="step"><b>Received</b><span>Item delivered successfully.</span></div>
      </div>
    </section>

    <section id="contact">
      <div class="section-head">
        <div>
          <h2>Contact Henzify</h2>
          <p>These links are clickable so customers can open your accounts directly.</p>
        </div>
      </div>

      <div class="contact">
        <div class="panel">
          <h3>Direct Contact</h3>
          <div class="list">
            <div>Facebook: <a href="https://www.facebook.com/henzpacaldo" target="_blank" rel="noopener">Henz Quiring Pacaldo</a></div>
            <div>TikTok: <a href="https://www.tiktok.com/@just.henz?_r=1&_t=ZS-99LLS1EmkR6" target="_blank" rel="noopener">Just Henz</a></div>
            <div>Email: <a href="mailto:henz@gmail.com">henz@gmail.com</a></div>
          </div>
        </div>

        <div class="panel">
          <h3>Customer Order Form</h3>
          <form class="form">
            <input type="text" placeholder="Full Name" />
            <input type="text" placeholder="Contact Number" />
            <input type="text" placeholder="Complete Location" />
            <input type="text" placeholder="Product Name" />
            <input type="text" placeholder="Quantity" />
            <textarea placeholder="Order note or delivery instruction"></textarea>
            <a class="btn primary" href="https://wa.me/" target="_blank" rel="noopener">Submit Order</a>
          </form>
        </div>
      </div>
    </section>
  </main>

  <div class="footer">© 2026 Henzify. All rights reserved.</div>
</body>
</html>
